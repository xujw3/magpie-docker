# 复制成 .env 后修改：cp .env.example .env

# 镜像标签：latest / daily / stable / 具体版本如 0.1.1150 / edge
MAGPIE_TAG=latest

# Web 界面 key，必须设置，至少 16 个字符
# 生成：openssl rand -hex 16
MAGPIE_WEB_KEY=

# 其他机器访问网关的地址（宿主机/NAS 的 IP + 发布的端口）
MAGPIE_PUBLIC_URL=http://127.0.0.1:3425

# 端口绑定的宿主地址：
#   127.0.0.1  = 只在宿主机（默认，最安全）
#   0.0.0.0    = 所有网卡（配合 MAGPIE_PUBLIC_URL 与网关密钥）
#   192.168.1.20 = 只绑某个局域网/VPN 地址
MAGPIE_BIND=127.0.0.1
